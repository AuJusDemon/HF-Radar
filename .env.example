# ── HF Radar Configuration ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit it.
# ───────────────────────────────────────────────────────────────────────────────


# ── Telegram ────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your-telegram-bot-token

# Telegram chat ID to use with: python bot.py --test
TEST_CHAT_ID=0


# ── HackForums OAuth ────────────────────────────────────────────────────────────
HF_CLIENT_ID=hf_clientid_...
HF_CLIENT_SECRET=hf_secret_...


# ── Transport ───────────────────────────────────────────────────────────────────
# HackForums uses Cloudflare — datacenter/VPS IPs are blocked.
# You need a residential proxy. socks5:// and http:// are both supported.
HF_PROXY_URL=socks5://user:pass@your-residential-proxy:port


# ── Database ─────────────────────────────────────────────────────────────────────
# MySQL (recommended for prod — auto-selected when DB_HOST is set):
DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-mysql-dbname

# SQLite fallback (used automatically when DB_HOST is NOT set):
# DB_PATH=hfradar.db


# ── Optional ────────────────────────────────────────────────────────────────────
STARTUP_DELAY_SECONDS=0
